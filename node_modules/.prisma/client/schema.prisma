// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String?
  roleId   String
  role     Role     @relation(fields: [roleId], references: [id])
  tests    Test[] // Тесты (для роли TEACHER)
  results  Result[] // Результаты (для роли STUDENT)
}

model Role {
  id    String @id @default(uuid())
  name  String @unique // "TEACHER", "STUDENT", "ADMIN"
  users User[]
}

model Test {
  id          String  @id @default(uuid())
  title       String
  description String?
  authorId    String
  author      User    @relation(fields: [authorId], references: [id])

  // Связь с категориями
  categories Category[] @relation("TestToCategory")
  questions  Question[]
  results    Result[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  tests       Test[]   @relation("TestToCategory")
  createdAt   DateTime @default(now())
}

model Question {
  id      String       @id @default(uuid())
  text    String
  order   Int
  testId  String
  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  typeId  String
  type    QuestionType @relation(fields: [typeId], references: [id])
  options Option[]
}

model QuestionType {
  id        String     @id @default(uuid())
  name      String     @unique // "SINGLE", "MULTIPLE", "TEXT"
  label     String // адекватное название для фронтенда
  questions Question[]
}

model Option {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Result {
  id        String   @id @default(uuid())
  score     Int
  testId    String
  test      Test     @relation(fields: [testId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  answers   Json
  createdAt DateTime @default(now())
}
